<?xml version='1.0' encoding='utf-8'?>
<widget id="de.zirkelwerk.app"
        version="0.10.0"
        android-versionCode="1000"
        ios-CFBundleVersion="1000"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Grundname ist der englische. Deutsch kommt über die Sprachdateien
         (res/ios/de.lproj, res/android/values-de). So sieht jede Sprache
         außer Deutsch "Compasswork" – auch Französisch oder Türkisch, wo
         ein deutscher Name neben englischer Oberfläche seltsam wäre. -->
    <name>Compasswork</name>
    <description>Geometrische Konstruktionen mit Zirkel, Geodreieck und Lineal auf Karopapier.</description>
    <author email="smaehlmann.appdev@gmail.com">Wisdompeak Apps – Simon Mählmann</author>

    <content src="index.html" />

    <!-- Kein <access origin="*">: Die App lädt nichts aus dem Netz.
         mailto- und https-Links gehen an Mail bzw. den System-Browser. -->
    <allow-intent href="mailto:*" />
    <allow-intent href="https://*/*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="default" />
    <preference name="BackgroundColor" value="0xfffaf8f3" />

    <platform name="android">
        <preference name="android-minSdkVersion"     value="24" />
        <preference name="android-targetSdkVersion"  value="36" />
        <preference name="android-compileSdkVersion" value="36" />
        <preference name="AndroidInsecureFileModeEnabled" value="false" />
        <preference name="AndroidXEnabled" value="true" />
        <!-- Ein Link aus der Kamera-App soll die laufende App erreichen, nicht
             eine zweite Instanz im Task der Kamera starten. -->
        <preference name="AndroidLaunchMode" value="singleTask" />
        <!-- Ab Android 16 (Ziel-SDK 36) kommt die Zurück-Taste sonst nicht mehr
             als backbutton-Ereignis an: cordova-android 15 nutzt noch den alten
             Weg. Der vorübergehende Opt-out ist offiziell vorgesehen; ersetzen,
             sobald Cordova OnBackInvokedCallback unterstützt. -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:enableOnBackInvokedCallback="false" />
        </edit-config>
        <!-- Kein Edge-to-Edge: Cordova rückt die Web-Ansicht aus Status- und
             Navigationsleiste heraus (Android 16 erzwingt sonst randlos). -->
        <preference name="AndroidEdgeToEdge" value="false" />
        <!-- Den Link, mit dem die App gestartet wurde, nach dem Verarbeiten
             vergessen – sonst kommt er nach jedem Neuladen der Seite wieder. -->
        <preference name="CustomURLSchemePluginClearsAndroidIntent" value="true" />

        <preference name="AndroidWindowSplashScreenBackground" value="#234e8c" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/android/icon_fg_xxxhdpi.png" />

        <resource-file src="res/android/colors.xml" target="/app/src/main/res/values/zirkelwerk_colors.xml" />
        <!-- Deutscher App-Name unter dem Icon -->
        <resource-file src="res/android/values-de/strings.xml" target="/app/src/main/res/values-de/strings.xml" />

        <icon density="ldpi"    background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_ldpi.png"    src="res/android/icon_ldpi.png" />
        <icon density="mdpi"    background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_mdpi.png"    src="res/android/icon_mdpi.png" />
        <icon density="hdpi"    background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_hdpi.png"    src="res/android/icon_hdpi.png" />
        <icon density="xhdpi"   background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_xhdpi.png"   src="res/android/icon_xhdpi.png" />
        <icon density="xxhdpi"  background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_xxhdpi.png"  src="res/android/icon_xxhdpi.png" />
        <icon density="xxxhdpi" background="@color/zirkelwerk_icon_background" foreground="res/android/icon_fg_xxxhdpi.png" src="res/android/icon_xxxhdpi.png" />
    </platform>

    <platform name="ios">
        <!-- Apple nimmt ab Frühjahr 2027 keine Uploads mit niedrigerem Wert
             mehr an (Erfahrung aus FairMix, Warnung 90068). -->
        <preference name="deployment-target" value="15.0" />

        <!-- iPad und iPhone (universal). Entschieden im Oktober 2026 vor dem
             ersten Upload. Achtung: Eine universale App lässt sich später
             nicht mehr auf iPad beschränken. Der Store braucht dafür auch
             iPhone-Bildschirmfotos (6,9 Zoll), die Prüfung läuft auf beiden. -->
        <preference name="target-device" value="universal" />

        <!-- Aus, anders als bei FairMix: In einer Zeichen-App würde ein Strich
             am linken Rand sonst eine Seite zurückblättern. Die Rechtstexte
             haben eigene Knöpfe "Zurück zur App". -->
        <preference name="AllowBackForwardNavigationGestures" value="false" />

        <!-- Kopfleiste hell: dunkle Statusleisten-Schrift. Im dunklen Modus
             schaltet updateStatusBar() in der App auf helle Schrift um. -->
        <preference name="StatusBarOverlaysWebView" value="true" />
        <preference name="StatusBarStyle" value="default" />

        <edit-config target="ITSAppUsesNonExemptEncryption" file="*-Info.plist" mode="overwrite">
            <false/>
        </edit-config>

        <!-- Entwicklungsregion Englisch: Sprachen ohne eigene Datei fallen
             auf Englisch zurück, also auf "Compasswork". -->
        <edit-config target="CFBundleDevelopmentRegion" file="*-Info.plist" mode="overwrite">
            <string>en</string>
        </edit-config>
        <edit-config target="CFBundleLocalizations" file="*-Info.plist" mode="overwrite">
            <array>
                <string>en</string>
                <string>de</string>
            </array>
        </edit-config>
        <resource-file src="res/ios/en.lproj/InfoPlist.strings" target="en.lproj/InfoPlist.strings" />
        <resource-file src="res/ios/de.lproj/InfoPlist.strings" target="de.lproj/InfoPlist.strings" />

        <!-- Das Teilen-Plugin bringt Schlüssel für die Fotomediathek mit, und
             zwar mit Cordovas Platzhaltertext. Apples automatische Prüfung
             weist Platzhalter ab, bevor ein Mensch die App sieht (bei FairMix
             Build 12203 passiert). Zirkelwerk liest keine Fotos; die Texte
             beschreiben nur, was beim Teilen passieren kann. -->
        <edit-config target="NSPhotoLibraryAddUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Zirkelwerk legt auf deinen Wunsch ein Bild deiner Zeichnung in der Fotomediathek ab. Vorhandene Fotos werden nicht gelesen.</string>
        </edit-config>
        <edit-config target="NSPhotoLibraryUsageDescription" file="*-Info.plist" mode="overwrite">
            <string>Zirkelwerk legt auf deinen Wunsch ein Bild deiner Zeichnung in der Fotomediathek ab. Vorhandene Fotos werden weder gelesen noch verändert.</string>
        </edit-config>

        <!-- Kein <resource-file> für das Privacy-Manifest: cordova-ios 8 legt
             selbst eines an, ein zweites ergibt "duplicate output file".
             Der Workflow ersetzt das mitgelieferte durch res/ios/PrivacyInfo.xcprivacy. -->

        <!-- Ohne Alphakanal, erzeugt von make-icons.py -->
        <icon src="res/ios/icon-20.png"   width="20"   height="20" />
        <icon src="res/ios/icon-29.png"   width="29"   height="29" />
        <icon src="res/ios/icon-40.png"   width="40"   height="40" />
        <icon src="res/ios/icon-58.png"   width="58"   height="58" />
        <icon src="res/ios/icon-60.png"   width="60"   height="60" />
        <icon src="res/ios/icon-76.png"   width="76"   height="76" />
        <icon src="res/ios/icon-80.png"   width="80"   height="80" />
        <icon src="res/ios/icon-87.png"   width="87"   height="87" />
        <icon src="res/ios/icon-120.png"  width="120"  height="120" />
        <icon src="res/ios/icon-152.png"  width="152"  height="152" />
        <icon src="res/ios/icon-167.png"  width="167"  height="167" />
        <icon src="res/ios/icon-180.png"  width="180"  height="180" />
        <icon src="res/ios/icon-1024.png" width="1024" height="1024" />

        <splash src="res/ios/Default@2x~universal~anyany.png" />
    </platform>

    <!-- Export von Blättern über das Teilen-Menü (Dateien, AirDrop, Mail).
         Auf dem iPad ist das Menü ein Popover – deliverFile() übergibt
         iPadPopupCoordinates, sonst bricht UIKit die App ab. -->
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />
    <plugin name="cordova-plugin-statusbar" spec="^4.0.0" />

    <!-- Aufgaben per QR-Code: zirkelwerk://-Links öffnen die App. Das Plugin
         trägt das Schema ein (iOS: CFBundleURLTypes, Android: intent-filter)
         und reicht den Link auf Android an window.handleOpenURL weiter; iOS
         ruft handleOpenURL ohnehin selbst auf. ANDROID_SCHEME gesetzt, sonst
         legt das Plugin einen zweiten Filter mit Schema " " an. -->
    <plugin name="cordova-plugin-customurlscheme" spec="^5.0.2">
        <variable name="URL_SCHEME" value="zirkelwerk" />
        <variable name="ANDROID_SCHEME" value="zirkelwerk" />
        <variable name="ANDROID_HOST" value="s" />
    </plugin>

    <!-- Vollversion per In-App-Kauf: erst aktivieren, wenn das Produkt
         de.zirkelwerk.app.vollversion in App Store Connect und der Play
         Console angelegt ist. Dann diese Zeile einkommentieren und in der
         index.html LIMITS_ACTIVE und IAP_ENABLED auf true setzen.
         Datenschutzerklärung und Data-Safety-Formular sind darauf
         vorbereitet.
    <plugin name="cordova-plugin-purchase" spec="^13.12.0" />
    -->
</widget>
